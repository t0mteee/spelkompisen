<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.saman.spelkompisen.snapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/saman/spelkompisen/backend/scripts/snapshot.sh</string>
    </array>

    <!-- Fast väggklocka: jobbets körtid får inte driva 30 min till ~51 min. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/saman/spelkompisen/backend/data/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/saman/spelkompisen/backend/data/launchd.err.log</string>
</dict>
</plist>
